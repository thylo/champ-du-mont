# Copier en .env puis adapter. Ne jamais committer .env.

# Admin CouchDB (Fauxton, sauvegardes)
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me
# Secret des cookies de session — générer avec : openssl rand -hex 32
COUCHDB_SECRET=change-me-too
COUCHDB_PORT=5984

# Mots de passe des deux utilisateurs de l'app
BENEVOLE_PASSWORD=benevole
GESTION_PASSWORD=gestion

# Bénéficiaire des virements (intégré au QR au build)
VITE_BENEFICIAIRE=Champ du Mont
VITE_IBAN=BE68 5390 0754 7034
# Où mettre la communication dans le QR : structure (champ structuré) ou libre
VITE_CHAMP_REF=structure

# Port public de l'app en prod
APP_PORT=8080

# Utilisé par le proxy du serveur de dev Vite
COUCHDB_URL=http://localhost:5984
